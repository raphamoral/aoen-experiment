# Factor III — copie para .env e preencha os valores reais
# NUNCA versione o .env com credenciais reais

# Backing service — Factor IV
DATABASE_URL=postgresql://certifica:senha@localhost:5432/certifica_digital

# Segredos
SECRET_KEY=substitua-por-64-caracteres-aleatorios-gerados-com-secrets.token_hex

# Identidade da plataforma
APP_NAME=CertificaDigital
CERTIFICATE_ISSUER=Plataforma CertificaDigital

# Ambiente (development | staging | production)
ENVIRONMENT=development

# Rede
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# Observabilidade — Factor XI
LOG_LEVEL=INFO