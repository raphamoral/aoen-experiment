# 12-factor III: Config — toda configuração no ambiente, nunca no código
# Copie para .env e preencha os valores reais. Nunca comite o .env.

# Application
APP_NAME="Compliance Freelancer Marketplace"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO
PORT=8000
WEB_CONCURRENCY=2

# Backing services (12-factor IV) — trate cada serviço como recurso anexado via URL
# Trocar de PostgreSQL local para RDS é apenas mudar DATABASE_URL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/compliance_marketplace
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Serviços externos como recursos anexados
EMAIL_SERVICE_URL=smtp://user:password@smtp.mailprovider.com:587
STORAGE_BUCKET_URL=s3://my-bucket-name