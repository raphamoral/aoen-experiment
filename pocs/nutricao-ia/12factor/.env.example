# Factor III: Config — todas as configurações via variáveis de ambiente
# Copie para .env e preencha os valores reais (nunca commite .env)

# Aplicação
APP_ENV=development
APP_SECRET_KEY=changeme-use-secrets-manager-in-prod
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=2

# Banco de dados (backing service — Factor IV)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nutrition_db

# Redis (backing service — Factor IV)
REDIS_URL=redis://localhost:6379/0

# Anthropic (backing service — Factor IV)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# Logging (Factor XI — logs como streams)
LOG_LEVEL=INFO
LOG_FORMAT=json